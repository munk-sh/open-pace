        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轨迹与位置数据属于敏感个人信息。PurePace 只在你同意后才开始记录，采集的数据只存在本机。你可以拒绝授权，拒绝后仍可使用应用，但无法开始记录跑步；也可以随时撤回同意。"
          }
        }
