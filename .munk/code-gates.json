{
  "version": 1,
  "description": "PurePace 协作基线门禁：lint 做 shell 语法检查，test 真实执行 scripts/check-baseline.sh 结构断言。iOS 侧另有 ios/Core SwiftPM 包的真实 build/test 门与结构断言门（零第三方依赖、无业务实现、无写死版本），以及 iOS 空壳工程的 XcodeGen 结构断言（check-ios-shell）与 iOS 构建/测试脚本契约断言（check-ios-scripts），build-ios / test-ios 真实执行（工程可用时走 xcodebuild，缺失时显式 blocked 并降级 SwiftPM）。",
  "gates": [
    {
      "id": "lint",
      "cwd": ".",
      "command": "bash -n scripts/version.sh"
    },
    {
      "id": "lint-baseline",
      "cwd": ".",
      "command": "bash -n scripts/check-baseline.sh"
    },
    {
      "id": "lint-ios-core",
      "cwd": ".",
      "command": "bash scripts/check-ios-core.sh"
    },
    {
      "id": "lint-ios-scripts",
      "cwd": ".",
      "command": "bash scripts/check-ios-scripts.sh"
    },
    {
      "id": "lint-ios-shell",
      "cwd": ".",
      "command": "bash scripts/check-ios-shell.sh"
    },
    {
      "id": "build-ios-core",
      "cwd": ".",
      "command": "swift build --package-path ios/Core"
    },
    {
      "id": "build-ios",
      "cwd": ".",
      "command": "bash scripts/build-ios.sh"
    },
    {
      "id": "test-ios-core",
      "cwd": ".",
      "command": "swift test --package-path ios/Core"
    },
    {
      "id": "test-ios",
      "cwd": ".",
      "command": "bash scripts/test-ios.sh"
    },
    {
      "id": "test",
      "cwd": ".",
      "command": "bash scripts/check-baseline.sh"
    },
    {
      "id": "check-shared",
      "cwd": ".",
      "command": "bash scripts/check-shared.sh"
    }
  ]
}
